{
  "name": "studio-des-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Le Studio des agents : montage vidéo, retouche photo et design par une équipe d'agents Claude Code, dans un studio en pixel art. Adapté du Bureau des agents de VibesMoney (MIT).",
  "license": "MIT",
  "keywords": [
    "claude-code",
    "agents",
    "ai-agents",
    "pixel-art",
    "subagents"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node scripts/check-node.mjs && vite build --logLevel warn && node server/index.ts --open",
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "serve": "node server/index.ts",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "marked": "^18.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zustand": "^5.0.15",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
